#!/bin/bash
#
# LXI - LX Interface
# Main command dispatcher for the LXI framework
#
# Usage: lxi <command> [options]
#

set -e

# Determine script directory and repository root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_DIR="$REPO_ROOT/agents/skills"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
print_error() {
    echo -e "${RED}Error:${NC} $1" >&2
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Version
VERSION="1.0.0"

# Show help/usage
show_help() {
    cat << EOF
${GREEN}lxi${NC} - LX Interface

A repository-centric workflow orchestration framework.

${BLUE}Usage:${NC}
  lxi <command> [options]

${BLUE}Commands:${NC}

  ${GREEN}Document Creation:${NC}
    create adr [topic]              Create new Architecture Decision Record
    create design-review [feature]  Create new Design Review document

  ${GREEN}Progress Tracking:${NC}
    update lx [YYYY-MM-DD]          Update weekly LX document
    standup generate [YYYY-MM-DD]   Generate daily standup from Git commits

  ${GREEN}External System Sync:${NC}
    sync jira                       Sync repository to Jira
    sync confluence                 Sync LX documents to Confluence
    sync all                        Sync to all external systems

  ${GREEN}Quality & Maintenance:${NC}
    validate                        Validate cross-references
    check freshness [days]          Check for stale documents (default: 30 days)
    archive lx [YYYY-MM-DD]         Archive old LX documents

  ${GREEN}Help & Information:${NC}
    help                            Show this help message
    version                         Show version information

${BLUE}Examples:${NC}
  lxi create adr "Database Selection"
  lxi create design-review "User Authentication"
  lxi update lx
  lxi standup generate
  lxi sync all
  lxi validate
  lxi check freshness 60
  lxi archive lx

${BLUE}Documentation:${NC}
  See ${REPO_ROOT}/commands/README.md for detailed command reference
  See ${REPO_ROOT}/ARCHITECTURE.md for system overview

${BLUE}LXI Framework:${NC}
  LXI = LX In-Sync
  - LX is derived from L10 meeting model (L5, L10, L20)
  - In-Sync means engineering and business stay automatically synchronized
  - I completes "In-Sync" - keeping multiple levels aligned

EOF
}

# Show version
show_version() {
    echo "lxi version $VERSION"
    echo "Repository: $REPO_ROOT"
}

# Check if skill script exists and is executable
check_skill() {
    local skill_script="$1"
    if [ ! -f "$skill_script" ]; then
        print_error "Skill script not found: $skill_script"
        return 1
    fi
    if [ ! -x "$skill_script" ]; then
        print_warning "Skill script not executable, making it executable: $skill_script"
        chmod +x "$skill_script"
    fi
    return 0
}

# Execute skill script
run_skill() {
    local skill_script="$1"
    shift

    if ! check_skill "$skill_script"; then
        exit 1
    fi

    # Execute the skill script with remaining arguments
    "$skill_script" "$@"
}

# Main command dispatcher
main() {
    # Check if no arguments provided
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    # Parse command
    local command="$1"
    shift

    case "$command" in
        # Help and version
        help|--help|-h)
            show_help
            exit 0
            ;;
        version|--version|-v)
            show_version
            exit 0
            ;;

        # Document creation commands
        create)
            if [ $# -eq 0 ]; then
                print_error "Missing create subcommand. Usage: lxi create [adr|design-review] [name]"
                exit 1
            fi

            local subcommand="$1"
            shift

            case "$subcommand" in
                adr)
                    run_skill "$SKILLS_DIR/create-adr.sh" "$@"
                    ;;
                design-review|dr)
                    run_skill "$SKILLS_DIR/create-design-review.sh" "$@"
                    ;;
                *)
                    print_error "Unknown create subcommand: $subcommand"
                    echo "Available: adr, design-review"
                    exit 1
                    ;;
            esac
            ;;

        # Update commands
        update)
            if [ $# -eq 0 ]; then
                print_error "Missing update subcommand. Usage: lxi update lx [date]"
                exit 1
            fi

            local subcommand="$1"
            shift

            case "$subcommand" in
                lx)
                    run_skill "$SKILLS_DIR/update-lx.sh" "$@"
                    ;;
                *)
                    print_error "Unknown update subcommand: $subcommand"
                    echo "Available: lx"
                    exit 1
                    ;;
            esac
            ;;

        # Standup commands
        standup)
            if [ $# -eq 0 ]; then
                print_error "Missing standup subcommand. Usage: lxi standup generate [date]"
                exit 1
            fi

            local subcommand="$1"
            shift

            case "$subcommand" in
                generate|gen)
                    run_skill "$SKILLS_DIR/standup-update.sh" "$@"
                    ;;
                *)
                    print_error "Unknown standup subcommand: $subcommand"
                    echo "Available: generate"
                    exit 1
                    ;;
            esac
            ;;

        # Sync commands
        sync)
            if [ $# -eq 0 ]; then
                print_error "Missing sync target. Usage: lxi sync [jira|confluence|all]"
                exit 1
            fi

            local target="$1"
            shift

            case "$target" in
                jira)
                    run_skill "$SKILLS_DIR/sync-jira.sh" "$@"
                    ;;
                confluence)
                    run_skill "$SKILLS_DIR/sync-confluence.sh" "$@"
                    ;;
                all)
                    print_info "Syncing to all external systems..."

                    # Run Jira sync
                    if check_skill "$SKILLS_DIR/sync-jira.sh"; then
                        print_info "Syncing to Jira..."
                        "$SKILLS_DIR/sync-jira.sh" "$@" || print_warning "Jira sync failed"
                    fi

                    # Run Confluence sync
                    if check_skill "$SKILLS_DIR/sync-confluence.sh"; then
                        print_info "Syncing to Confluence..."
                        "$SKILLS_DIR/sync-confluence.sh" "$@" || print_warning "Confluence sync failed"
                    fi

                    print_success "Sync complete"
                    ;;
                *)
                    print_error "Unknown sync target: $target"
                    echo "Available: jira, confluence, all"
                    exit 1
                    ;;
            esac
            ;;

        # Validate command
        validate)
            run_skill "$SKILLS_DIR/validate-references.sh" "$@"
            ;;

        # Check commands
        check)
            if [ $# -eq 0 ]; then
                print_error "Missing check subcommand. Usage: lxi check freshness [days]"
                exit 1
            fi

            local subcommand="$1"
            shift

            case "$subcommand" in
                freshness|fresh)
                    run_skill "$SKILLS_DIR/check-freshness.sh" "$@"
                    ;;
                *)
                    print_error "Unknown check subcommand: $subcommand"
                    echo "Available: freshness"
                    exit 1
                    ;;
            esac
            ;;

        # Archive commands
        archive)
            if [ $# -eq 0 ]; then
                print_error "Missing archive subcommand. Usage: lxi archive lx [date]"
                exit 1
            fi

            local subcommand="$1"
            shift

            case "$subcommand" in
                lx)
                    run_skill "$SKILLS_DIR/archive-weekly.sh" "$@"
                    ;;
                *)
                    print_error "Unknown archive subcommand: $subcommand"
                    echo "Available: lx"
                    exit 1
                    ;;
            esac
            ;;

        # Unknown command
        *)
            print_error "Unknown command: $command"
            echo ""
            echo "Run 'lxi help' for usage information"
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
